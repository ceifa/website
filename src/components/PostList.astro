---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"posts">[];
}

const { posts } = Astro.props;
const month = new Intl.DateTimeFormat("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
---

{/* The archive's entries (see posts.astro). */}
<ul class="post-list" role="list">
  {
    posts.map((post, i) => (
      <li class="entry" data-land={i ? "line" : undefined}>
        <h3>
          <a href={`/${post.id}`}>
            <span data-land="text">{post.data.title}</span>
          </a>
        </h3>
        <time class="entry-date" datetime={post.data.written.toISOString().slice(0, 10)}>
          {month.format(post.data.written)}
        </time>
      </li>
    ))
  }
</ul>
