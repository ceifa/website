---
import { Font } from "astro:assets";
import Social from "../components/Social.astro";
import "../styles/site.css";
import "../styles/scenes.css";

interface Props {
  title: string;
  description: string;
  section?: string;
  // Set on post pages: marks the page up as an article for crawlers and link previews.
  article?: { headline: string; published: Date };
}

// With build.format "file" pages render as /projects.html; their public URL is /projects.
const path = Astro.url.pathname.replace(/(index)?\.html$/, "");
const { title, description, section = path, article } = Astro.props;
const canonical = new URL(path, Astro.site);
const author = { "@type": "Person", name: "Gabriel Francisco", url: new URL("/about", Astro.site) };
const jsonLd =
  article &&
  JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: article.headline,
    description,
    datePublished: article.published.toISOString(),
    url: canonical,
    mainEntityOfPage: canonical,
    author,
  }).replaceAll("<", "\\u003c");
const nav = [
  ["/projects", "Projects"],
  ["/posts", "Posts"],
  ["/about", "About"],
];
// The night sky: the same few stars on every page, scattered at build time
// and thinning out towards the text.
let seed = 11;
const random = () => (seed = (seed * 16807) % 2147483647) / 2147483647;
const stars = Array.from({ length: 30 }, (_, i) => ({
  class: i % 3 ? undefined : "twinkle",
  style: [
    `left:${(random() * 100).toFixed(1)}%`,
    `top:${(random() ** 1.7 * 100).toFixed(1)}%`,
    `scale:${(0.5 + random() * 0.7).toFixed(2)}`,
    `animation-delay:-${(random() * 6).toFixed(1)}s`,
  ].join(";"),
}));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? "article" : "website"} />
    {article && <meta property="article:published_time" content={article.published.toISOString()} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content="@_ceifa" />
    <link rel="alternate" type="application/rss+xml" title="ceifa" href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <Font cssVariable="--font-site" preload />
    <Font cssVariable="--font-display" preload />
    {jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}
    <script is:inline>
      // Apply a theme chosen with the header toggle before the first paint.
      try {
        const theme = localStorage.getItem("theme");
        if (theme === "light" || theme === "dark") document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="sky" aria-hidden="true">
      <div class="sky-night">
        {stars.map((star) => <i class={star.class} style={star.style} />)}
        <span class="shooting-star" id="shooting-star"></span>
      </div>
      <div class="sky-day">
        <span class="cloud"></span>
        <span class="cloud"></span>
      </div>
    </div>
    <div class="site" id="top">
      <header class="header">
        <a href="/" class="logo">ceifa<i>.</i></a>
        <div class="header-end">
          <nav aria-label="Main">
            {
              nav.map(([href, label]) => (
                <a href={href} aria-current={href === section ? "page" : undefined}>
                  {label}
                </a>
              ))
            }
          </nav>
          <button class="theme-toggle" id="theme-toggle" type="button" hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <g class="sun">
                <circle cx="12" cy="12" r="4.5"></circle>
                <path
                  d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"
                ></path>
              </g>
              <path class="moon" d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"></path>
            </svg>
          </button>
        </div>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="footer" data-land="top">
        <p>Gabriel Francisco, ceifa.</p>
        <Social class="elsewhere footer-elsewhere" />
        <div class="lounge" id="lounge">
          <span class="armchair" aria-hidden="true">
            <span class="armchair-back"></span>
            <span class="armchair-arm left"></span>
            <span class="armchair-arm right"></span>
            <span class="armchair-seat" data-land="top" data-seat></span>
          </span>
          <button
            class="radio"
            id="radio"
            type="button"
            aria-label="Radio. It plays while the little resident sits in the armchair. Press to turn the sound on or off."
            aria-pressed="true"
            hidden
          >
            <span class="radio-grille"></span><span class="radio-dial"></span>
            <span class="radio-notes"><i>♪</i><i>♫</i><i>♪</i></span>
          </button>
        </div>
      </footer>
      <noscript>
        <p>The site works without JavaScript. The little resident shows up when it can.</p>
      </noscript>
    </div>
    <button
      class="resident"
      id="resident"
      aria-label="The page's little resident. It follows your reading on its own. Drag it around or throw it, stroke it with the mouse, or double-click it for a somersault. Use the arrow keys or WASD to walk, jump and drop, Space to jump and Escape to let go."
      aria-pressed="false"
      hidden
    >
      <span class="pose">
        <span class="sprite"><span class="eyes"></span></span>
        <span class="leg left"></span>
        <span class="leg right"></span>
      </span>
      <span class="resident-fx"></span>
    </button>
    <script>
      import "../scripts/theme.mjs";
      import "../scripts/sky.mjs";
      import "../scripts/navigate.mjs";
      import "../scripts/scenes.mjs";
      import "../scripts/inhabit.mjs";
    </script>
  </body>
</html>
