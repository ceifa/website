---
import PostList from "../components/PostList.astro";
import Layout from "../layouts/Layout.astro";
import { getPosts } from "../lib/posts";
---

<Layout
  title="Posts · ceifa"
  description="Posts by Gabriel Francisco about programming, the web and Garry's Mod."
>
  <section class="page-head">
    <h1><span data-land="text" id="first-perch">Posts</span></h1>
  </section>
  <PostList posts={await getPosts()} />
</Layout>
