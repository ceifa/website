---
import Layout from "../layouts/Layout.astro";
import { getPosts } from "../lib/posts";

// Newest first, so the years come out in order too.
const years = Map.groupBy(await getPosts(), (post) => post.data.written.getUTCFullYear());
const day = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", timeZone: "UTC" });
---

<Layout
  title="Posts · ceifa"
  description="Posts by Gabriel Francisco about programming, the web and Garry's Mod."
>
  <section class="page-head">
    <h1><span data-land="text" id="first-perch">Posts</span></h1>
  </section>
  {
    [...years].map(([year, posts]) => (
      <section class="archive-year" data-land="line">
        {/* The year sticks on wide screens, so it's no place for the resident to stand. */}
        <h2>{year}</h2>
        {/* Safari forgets a list is a list once its markers are gone. */}
        <ul role="list">
          {posts.map((post, i) => (
            <li class="entry" data-land={i ? "line" : undefined}>
              <h3>
                <a href={`/${post.id}`}>
                  <span data-land="text">{post.data.title}</span>
                </a>
              </h3>
              <time class="entry-date" datetime={post.data.written.toISOString().slice(0, 10)}>
                {day.format(post.data.written)}
              </time>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Layout>
