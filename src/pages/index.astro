---
import PostList from "../components/PostList.astro";
import Layout from "../layouts/Layout.astro";
import { getPosts } from "../lib/posts";

const posts = (await getPosts()).slice(0, 4);
---

<Layout
  title="ceifa · code, games and other stories"
  description="Gabriel Francisco's corner of the internet. Open source projects, posts and other stories."
>
  <section class="hero">
    <h1>
      <span data-land="text">Code, games</span><span data-land="text" id="first-perch"
        >and other <em>stories.</em></span
      >
    </h1>
  </section>
  <section>
    <div class="section-heading" data-land="bottom">
      <h2>Latest writings</h2>
    </div>
    <PostList posts={posts} />
    {/* The section's one link to the archive, where the list ends. */}
    <p class="all-posts" data-land="line">
      <a href="/posts">
        <span data-land="text">All posts</span>
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 8h11M9 3.5 13.5 8 9 12.5"></path></svg>
      </a>
    </p>
  </section>
</Layout>
