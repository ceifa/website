---
import Featured from "../components/Featured.astro";
import PostList from "../components/PostList.astro";
import Layout from "../layouts/Layout.astro";
import { getPosts } from "../lib/posts";

const posts = (await getPosts()).slice(0, 3);
---

<Layout
  title="ceifa · code, games and other stories"
  description="Gabriel Francisco's corner of the internet. Open source projects, writing and other stories."
>
  <section class="hero">
    <div>
      <span class="hero-label">GABRIEL FRANCISCO / CEIFA</span>
      <h1>
        <span data-land="text">Code, games</span><span data-land="text" id="first-perch"
          >and other <em>stories.</em></span
        >
      </h1>
    </div>
  </section>
  <section id="projects">
    <div class="section-heading" data-land="bottom">
      <h2>
        Projects<button
          class="footnote"
          data-discovery="An agent doesn't have to live in a browser tab. Eleven started as a way to take that conversation anywhere."
          aria-label="A note about Eleven">*</button
        >
      </h2>
      <a href="/projects">All projects</a>
    </div>
    <Featured
      eleven="Your local AI agent, reachable from Discord and Telegram."
      wasmoon="Wasmoon compiles the real Lua VM to WebAssembly. Hundreds of thousands of downloads a month on npm."
    />
  </section>
  <section class="writing">
    <div class="section-heading" data-land="bottom">
      <h2>
        Writing<button
          class="footnote"
          data-discovery="“It's basically a community game where anyone can be a developer and make new things, and that's beautiful.” From the Garry's Mod post, 2020."
          aria-label="A line from the Garry's Mod post">*</button
        >
      </h2>
      <a href="/writing">All writing</a>
    </div>
    <PostList posts={posts} />
  </section>
  <section class="about">
    <div class="section-heading" data-land="bottom">
      <h2>
        About<button
          class="footnote"
          data-discovery="In the Garry's Mod community since 2014, running servers since 2015."
          aria-label="A note about Garry's Mod">*</button
        >
      </h2>
      <a href="/about">More</a>
    </div>
    <a class="about-teaser" href="/about"
      ><span data-land="text">A wild duck that will probably <em>break your code.</em></span></a
    >
  </section>
</Layout>
