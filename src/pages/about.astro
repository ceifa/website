---
import { getImage } from "astro:assets";
import dark from "../assets/gabriel-dark.png";
import light from "../assets/gabriel-light.png";
import Layout from "../layouts/Layout.astro";

// The portrait's silhouette for the resident: the top edge of the figure in 48 equal
// columns, as fractions of the image height. Both theme variants share it.
const contour = JSON.stringify([
  0.726, 0.51, 0.445, 0.405, 0.389, 0.388, 0.36, 0.359, 0.351, 0.351, 0.383, 0.383, 0.142, 0.088,
  0.061, 0.049, 0.035, 0.027, 0.014, 0.006, 0.003, 0.004, 0.005, 0.005, 0.011, 0.019, 0.023, 0.038,
  0.049, 0.068, 0.121, 0.434, 0.446, 0.452, 0.465, 0.476, 0.486, 0.496, 0.499, 0.509, 0.519, 0.534,
  0.547, 0.563, 0.585, 0.623, 0.674, 0.812,
]);
// AVIF at quality 60 is closer to the original than the WebP fallback, at under
// two thirds of its size.
const widths = [400, 800];
const sizes = "(max-width: 700px) 320px, 400px";
const portraits = await Promise.all(
  [light, dark].map(async (src) => ({
    variant: src === dark ? "portrait-dark" : "portrait-light",
    avif: await getImage({ src, widths, format: "avif", quality: 60 }),
    webp: await getImage({ src, widths, format: "webp" }),
  })),
);
---

<Layout
  title="About · ceifa"
  description="Gabriel Francisco, ceifa on the internet. Software developer from Belo Horizonte, Brazil, and CTO at Wiv."
>
  <section class="about-hero">
    <div class="about-intro">
      <h1><span data-land="text" id="first-perch">Hi, I'm Gabriel.</span></h1>
      <p>
        <span data-land="text"
          >I'm a software developer from Belo Horizonte, Brazil, and I spend a good part of my free time
          on open source. A few of my projects found a real audience, like <a
            href="https://github.com/ceifa/wasmoon">Wasmoon</a
          > and <a href="https://github.com/ceifa/steamworks.js">steamworks.js</a>, and there are <a
            href="/projects">plenty of smaller things</a
          > too.</span
        >
      </p>
      <p>
        <span data-land="text"
          >I'm the CTO at <a href="https://wiv.com.br">Wiv</a>, a Brazilian
          company that builds conversational AI for businesses, mostly on WhatsApp. Every now and then
          I also <a href="/posts">write here</a>, mostly about programming.</span
        >
      </p>
      <p>
        <span data-land="text">My usual nickname is <code>ceifa</code>.</span>
      </p>
    </div>
    {
      portraits.map(({ variant, avif, webp }) => (
        <picture class:list={["portrait", variant]}>
          <source type="image/avif" srcset={avif.srcSet.attribute} sizes={sizes} />
          <img
            src={webp.src}
            srcset={webp.srcSet.attribute}
            sizes={sizes}
            width={webp.attributes.width}
            height={webp.attributes.height}
            alt="Illustration of Gabriel waving, in a grey t-shirt."
            loading="lazy"
            decoding="async"
            data-land="contour"
            data-contour={contour}
          />
        </picture>
      ))
    }
  </section>
  <div class="about-body">
    <h2><span data-land="text">Like my work?</span></h2>
    <p>
      <span data-land="text"
        >Pretty much everything I publish is MIT licensed, so you can do whatever you want with it. If
        something of mine saved you some time, you can <a href="https://github.com/sponsors/ceifa"
          >sponsor me on GitHub</a
        >.</span
      >
    </p>
  </div>
</Layout>
