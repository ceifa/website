---
import { Image } from "astro:assets";
import dark from "../assets/gabriel-dark.png";
import light from "../assets/gabriel-light.png";
import Layout from "../layouts/Layout.astro";

// Where the resident can stand on the portrait: [left, right, top] as fractions of the
// image box, traced from its silhouette (fingertips, head, right shoulder).
const floors = JSON.stringify([
  [0.12, 0.2, 0.36],
  [0.37, 0.54, 0.012],
  [0.66, 0.72, 0.445],
  [0.72, 0.79, 0.475],
  [0.79, 0.86, 0.51],
]);
---

<Layout
  title="About · ceifa"
  description="Gabriel Francisco, ceifa on the internet. Software developer from Belo Horizonte, Brazil, and CTO at Wiv."
>
  <section class="about-hero">
    <div class="about-intro">
      <h1><span data-land="text" id="first-perch">Hi, I'm Gabriel.</span></h1>
      <p>
        <span data-land="text"
          >I'm a software developer from Belo Horizonte, Brazil, and I spend a good part of my free time
          on open source. A few of my projects found a real audience, like <a
            href="https://github.com/ceifa/wasmoon">Wasmoon</a
          > and <a href="https://github.com/ceifa/steamworks.js">steamworks.js</a>, and there are <a
            href="/projects">plenty of smaller things</a
          > too.</span
        >
      </p>
      <p>
        <span data-land="text"
          >I'm the CTO at <a href="https://wiv.com.br">Wiv</a>, a Brazilian
          company that builds conversational AI for businesses, mostly on WhatsApp. Every now and then
          I also <a href="/posts">write here</a>, mostly about programming.</span
        >
      </p>
      <p>
        <span data-land="text">My usual nickname is <code>ceifa</code>.</span>
      </p>
    </div>
    {
      [light, dark].map((photo) => (
        <Image
          class:list={["portrait", photo === dark ? "portrait-dark" : "portrait-light"]}
          src={photo}
          alt="Illustration of Gabriel waving, in a grey t-shirt."
          widths={[400, 800]}
          sizes="(max-width: 700px) 320px, 400px"
          loading="lazy"
          data-land="contour"
          data-floors={floors}
        />
      ))
    }
  </section>
  <div class="about-body">
    <h2><span data-land="text">Like my work?</span></h2>
    <p>
      <span data-land="text"
        >Pretty much everything I publish is MIT licensed, so you can do whatever you want with it. If
        something of mine saved you some time, you can <a href="https://github.com/sponsors/ceifa"
          >sponsor me on GitHub</a
        >.</span
      >
    </p>
  </div>
</Layout>
